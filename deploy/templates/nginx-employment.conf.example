# ==============================================================================
# Nginx Reverse Proxy Template for Employment Platform
# Target path: /etc/nginx/sites-available/employment
# Enable via : sudo ln -sf /etc/nginx/sites-available/employment /etc/nginx/sites-enabled/employment
# Validate   : sudo nginx -t && sudo systemctl reload nginx
# HTTPS      : sudo certbot --nginx -d employment.example.com -m ops@example.com --redirect
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name employment.example.com;

    # Express accepts up to 10mb JSON payloads (Base64 resumes/photos)
    client_max_body_size 12m;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Response compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    access_log /var/log/employment/nginx-access.log;
    error_log  /var/log/employment/nginx-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
