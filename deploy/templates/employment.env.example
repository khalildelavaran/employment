# ==============================================================================
# Employment Platform — Production Environment Template
# Copy to: /etc/employment/employment.env
# Ownership & Mode: chown root:employment /etc/employment/employment.env
#                   chmod 640 /etc/employment/employment.env
# ==============================================================================

# --- Core Server Runtime ---
# Must be "production" so Express serves prebuilt dist/ instead of Vite dev server
NODE_ENV=production

# Bind strictly to loopback behind Nginx Reverse Proxy
HOST=127.0.0.1

# Internal HTTP port forwarded by Nginx
PORT=3000

# --- Persistent SQLite Database (WAL mode) ---
# Keep strictly outside /opt/employment/app so git updates/rollbacks never touch data
DB_PATH=/var/lib/employment/data/dasteva_d1.sqlite

# --- Public URL ---
# Used for self-referential links and environment documentation
APP_URL=https://profile.dastva.co

# --- FarazSMS / IranPayamak REST API (Server-Side Secret) ---
# Sent internally via HTTP header: Api-Key: <FARAZSMS_API_KEY>
# Leave FARAZSMS_API_KEY empty if SMS sending is disabled
FARAZSMS_BASE_URL=https://api.iranpayamak.com
FARAZSMS_API_KEY=
FARAZSMS_KEY_TITLE=emloyment
# Optional default dedicated/shared sender line (can also be configured in Admin UI)
FARAZSMS_LINE_NUMBER=
