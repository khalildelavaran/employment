[Unit]
Description=Employment Recruitment Platform (Dasteva Full-Stack Express + SQLite)
Documentation=https://github.com/khalildelavaran/employment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=employment
Group=employment
WorkingDirectory=/opt/employment/app
EnvironmentFile=/etc/employment/employment.env
ExecStart=/opt/employment/app/node_modules/.bin/tsx /opt/employment/app/server.ts
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
KillSignal=SIGTERM

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/employment/data

# Logging via systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=employment

[Install]
WantedBy=multi-user.target
