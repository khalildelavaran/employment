# Runtime & Network (Production Ubuntu defaults shown)
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"

# SQLite Database Path (Optional; defaults to ./.data/dasteva_d1.sqlite)
# In Ubuntu Production, keep database outside the git repo:
DB_PATH="/var/lib/employment/data/dasteva_d1.sqlite"

# APP_URL: Public URL where the Employment platform is hosted (used for links/references).
APP_URL="https://profile.dastva.co"

# FarazSMS / IranPayamak REST Web Service (Server-side only — NEVER expose to client)
# Auth uses HTTP header: Api-Key: <FARAZSMS_API_KEY>
FARAZSMS_BASE_URL="https://api.iranpayamak.com"
FARAZSMS_API_KEY="YOUR_FARAZSMS_API_KEY"
FARAZSMS_KEY_TITLE="emloyment"
FARAZSMS_LINE_NUMBER=""

# Optional: Reserved for future AI integrations (not currently required to boot)
GEMINI_API_KEY=""
